#!/usr/bin/env bash
# box-locked — Box CLI（box）を、この Mac の全 box プロセスで共有する排他ロックの下で実行する。
#
#   box-locked <box のサブコマンドと引数...>     ロックを取って box を1回実行する
#   box-locked --run <コマンド> [引数...]          ロックを取ったまま任意のコマンドを実行する（box-as 等の入口用）
#
# ~/bin/box としても配線する（PATH で本物の box より前に置く）。ふつうに `box ...` と打っても
# ロックを通る。ロックを持ったまま動くもの（box-as の中など）は環境変数 BOX_LOCK_HELD を見て
# ロックを取り直さず、本物の box をそのまま呼ぶ。
#
# なぜ要るか（2026-11-24 に、並行に動いた box が Box CLI の全環境の設定を空で上書きした）:
#   Box CLI 4.x は macOS で環境の設定を login Keychain の1項目（service=boxcli）に置く。
#   - 書き込みは `security add-generic-password` が重複で失敗したら削除して入れ直す、の2手で、
#     その間（十数ミリ秒）は項目が存在しない。
#   - どのコマンドも起動時にこの項目を読み、読めなければ（理由を問わず）空の既定値で上書きする。
#   したがって box が2つ同時に動き、一方の書き込みの隙間に他方が起動すると、全環境が消える。
#   既定環境を切り替える box-as は1回の実行で2回書き込むので、並行に動かすと起こりやすい。
#   ロックは flock（カーネルのロック）で取る。持ち主のプロセスが終われば自動で外れるので、
#   残骸で詰まることが無い。時間内に取れなければ実行せずに止まる（ロック無しで走らせない）。
set -uo pipefail

LOCKFILE="${HOME}/.box/.box-cli.lock"
WAIT_SECONDS="${BOX_LOCK_WAIT:-900}"

self=$(perl -MCwd=abs_path -e 'print abs_path(shift)' "${BASH_SOURCE[0]}")

# 本物の box（PATH 上で、この配線先＝自分自身ではない最初の box）を探す
real_box=""
IFS=: read -r -a path_dirs <<< "${PATH}"
for d in "${path_dirs[@]}"; do
  c="${d}/box"
  [[ -x "$c" && ! -d "$c" ]] || continue
  [[ "$(perl -MCwd=abs_path -e 'print abs_path(shift)' "$c")" == "$self" ]] && continue
  real_box="$c"
  break
done

run_mode=0
if [[ "${1:-}" == "--run" ]]; then
  run_mode=1
  shift
  [[ $# -ge 1 ]] || { echo "usage: box-locked --run <コマンド> [引数...]" >&2; exit 2; }
fi
if [[ $run_mode -eq 0 && -z "$real_box" ]]; then
  echo "box-locked: 本物の box が PATH に無い（npm install -g @box/cli）" >&2
  exit 127
fi

# 既にロックを持っている（box-as の中など）なら、そのまま実行する
if [[ -n "${BOX_LOCK_HELD:-}" ]]; then
  if [[ $run_mode -eq 1 ]]; then exec "$@"; else exec "$real_box" "$@"; fi
fi

mkdir -p "${HOME}/.box"
if [[ $run_mode -eq 1 ]]; then set -- "$@"; else set -- "$real_box" "$@"; fi

# $^F を上げてから開くと、ロックを持つ fd が exec の後も開いたまま残る（Perl は既定で close-on-exec を付ける）
exec perl -e '
  use Fcntl qw(:flock);
  my ($file, $wait, @cmd) = @ARGV;
  $^F = 1023;
  open(my $fh, ">>", $file) or die "box-locked: ロックファイルを開けない: $file: $!\n";
  local $SIG{ALRM} = sub { die "box-locked: ${wait} 秒待ってもロックを取れなかった（ほかの box が動いている）。実行していない: $file\n" };
  alarm $wait;
  flock($fh, LOCK_EX) or die "box-locked: flock に失敗: $!\n";
  alarm 0;
  $ENV{BOX_LOCK_HELD} = $$;
  exec { $cmd[0] } @cmd or die "box-locked: 実行できない: $cmd[0]: $!\n";
' "$LOCKFILE" "$WAIT_SECONDS" "$@"
