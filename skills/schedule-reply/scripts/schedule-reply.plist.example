<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  無人巡回（任意）。YOUR-USERNAME を自分のものに置き換えてから
  ~/Library/LaunchAgents/com.schedule-reply.plist として配置する。
  run.sh のパスは skill の配置先（既定は ~/.claude/skills/schedule-reply/scripts）。
  ログは個人データ側（~/.config/schedule-reply/logs/）へ集約する。
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.schedule-reply</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/YOUR-USERNAME/.claude/skills/schedule-reply/scripts/run.sh</string>
    </array>

    <!-- 15分ごとにポーリング（config.flags.dryRun が true の間は判定のみ・送信しない） -->
    <key>StartInterval</key>
    <integer>900</integer>

    <key>RunAtLoad</key>
    <true/>

    <!-- launchd は最小 env で起動するため PATH を明示（run.sh 側でも補強） -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/YOUR-USERNAME/.config/schedule-reply/logs/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/YOUR-USERNAME/.config/schedule-reply/logs/launchd.log</string>
</dict>
</plist>
