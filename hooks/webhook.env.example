# Google Chat の Incoming Webhook URL。
# このファイルをコピーして ~/.config/claude-chat-notify/webhook.env に置き、
# 実際の URL を入れる（chmod 600）。git には決して入れない。
CHAT_WEBHOOK_URL="https://chat.googleapis.com/v1/spaces/XXXX/messages?key=...&token=..."

# 応答が終わってからこの秒数だけ待ち、その間に次の依頼が入らなければ通知する。
# キューに積んだ依頼を消化している最中に鳴らさないための待ち時間。
CHAT_NOTIFY_QUIET_SECONDS=20
