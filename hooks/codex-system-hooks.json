{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|mcp__.+)$",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/.claude/hooks/codex-guard.py\"; [ -f \"$f\" ] || exit 0; python3 \"$f\"",
            "timeout": 30,
            "statusMessage": "検査（Claude Code のフック）"
          }
        ]
      }
    ]
  }
}
